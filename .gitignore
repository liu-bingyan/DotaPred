# Raw API pulls -- 126MB, and every byte of it is reproducible by running the
# scripts in scripts/fetch_*.py against OpenDota. Keeping it out of the repo
# keeps clones small; `make data` style reproduction is a ~30 min API job.
data/raw/

# Simulation outputs. Regenerated by simulate.py / simulate_boot.py /
# bootstrap_ranking.py in seconds to minutes.
*.npy

__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# API tokens. Never commit.
api/

# Local env / tooling. Nothing here should reach a public repo.
.env
.env.*
*.log
.venv/
venv/
.claude/
